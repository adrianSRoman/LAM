{
    "seed": 0,
    "description": "...des",
    "root_dir": "/path/to/LAM",
    "cudnn_deterministic": false,
    "trainer": {
        "module": "trainer.trainer",
        "main": "Trainer",
        "epochs": 50,
	    "upsample": true,
        "save_checkpoint_interval": 1,
        "validation": {
		"interval": 1,
		"find_max": true,
		"custom": {
                "visualize_limit": 30
            }
        }
    },
    "model": {
        "module": "model.UpLAM",
        "main": "UpLAM",
	"args": {
	}
    },
    "loss_function": {
        "module": "model.loss",
        "main": "MSETVLoss",
        "args": {
		"l1_weight": 0.00001
	}
    },
    "optimizer": {
        "lr": 0.000001,
        "beta1": 0.9,
        "beta2": 0.999
    },
    "train_dataset": {
        "module": "dataset.dataloader_multi_hdf",
        "main": "Dataset",
        "args": {
            "path_to_datasets": "/path/to/train_datasets",
            "freq_band": null,
	    "mode": "train", 
	    "leave_out": ["dataset1.hdf", "dataset2.hdf", "dataset3.hdf"] 
        }
    },
    "validation_dataset": {
    	"module": "dataset.dataloader_multi_hdf",
        "main": "Dataset",
        "args": {
            "path_to_datasets": "/path/to/val_datasets",
            "freq_band": null,
            "mode": "validation", 
            "leave_out": []
        }
    },
    "train_dataloader": {
        "batch_size": 8,
        "num_workers": 40,
        "shuffle": true,
        "pin_memory": true
    }
}
